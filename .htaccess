# Apache hardening for the Markdown viewer (ignored by other web servers).
Options -Indexes -MultiViews
DirectoryIndex index.php

# Only index.php, api.php, app.js and style.css need to be reachable.
<FilesMatch "^\.|^(lib|config)\.php$|\.(md|markdown|log|bak|swp|ini|lock|json|example)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always unset X-Powered-By
</IfModule>
